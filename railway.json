{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run build -w @prospect-me/labs",
    "watchPatterns": ["labs/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm run serve -w @prospect-me/labs",
    "restartPolicyType": "ON_FAILURE"
  }
}
